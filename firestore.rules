rules_version = '2';

// Security rules for the Congregation CMS.
//
// Fifteen collections, with deliberately different exposure:
//
//   auditLog        — append-only record of who changed what. Any staff account may add an
//                     entry as itself; only a Super Admin may read it; nobody may edit or
//                     delete one.
//
//   invitations     — pending invitations, keyed by lower-cased email. A Super Admin creates
//                     one; the invitee claims it on first sign-in, which is the only way an
//                     account can gain a role without a Super Admin writing it directly.
//
//   users/{uid}     — the role granted to a Firebase Auth account. This collection is
//                     the ONLY thing that grants privilege: every write rule below is
//                     gated on it. An account with no document here can sign in and
//                     reach the dashboard shell, but cannot write anything.
//
//   roleAssignments — which nominal-roll member holds which role in the congregation.
//                     Records standing, not access; most of these people have no login.
//
//   financeCollections, financeExpenses
//                   — the congregation's books. Staff may read; only Super Admin, Admin and
//                     the Financial Secretary may write.
//
//   visitors, childrenAttendance
//                   — who was at a service without being on the roll. Visitors carry biodata
//                     for people who are not even members, so never public. Staff read;
//                     Super Admin, Admin and the Secretary write.
//
//   messages        — the public contact form's inbox. An anonymous caller may only create
//                     an entry: a visitor cannot read back any message, including their own.
//                     Staff read and triage.
//
//   lectureshipRegistrations
//                   — signups from the public Bible Lectureship registration form. Same
//                     anonymous create-only shape as messages. Staff read, and may update only
//                     the attendedSat/attendedSun flags to check registrants in on the day.
//
//   settings/church — public site content (church name, service times, leaders,
//                     gallery, congregations, homepage events). The landing and
//                     about pages read this while signed out, so it is world
//                     readable. Super Admin and Admin may write.
//
//   memberNumbers   — reservation documents that make church (membership) numbers unique.
//                     Firestore has no unique constraint; this collection is it.
//
//   members         — the nominal roll. Contains names, phone numbers, home
//                     addresses and dates of birth, so it is NEVER publicly
//                     readable. The public registration form may CREATE a
//                     record (that is the whole point of /register), but only
//                     staff can read, edit, or delete one.
//
// BEFORE DEPLOYING: create the first users/{uid} document by hand, or you will lock
// yourself out — no rule here lets an account grant itself a role. Full procedure in
// docs/firebase-setup.md § Account roles.
//
// Deploy with:  firebase deploy --only firestore:rules -P staging
// then, once verified:  firebase deploy --only firestore:rules -P production

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── Roles ──────────────────────────────────────────────────────────────
    // Kept safe for anonymous callers: `roleId()` short-circuits on signedIn() before
    // touching request.auth.uid, so the public registration path below never errors.
    function hasRoleDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function roleId() {
      return hasRoleDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleId
        : '';
    }

    function isSuperAdmin() {
      return roleId() == 'super-admin';
    }

    // Mirrors STAFF_ROLES in stores/auth.ts — keep the two lists in step.
    function isStaff() {
      return roleId() in [
        'super-admin', 'admin', 'elder', 'deacon', 'preacher',
        'secretary', 'youth-leader', 'financial-secretary', 'content-editor'
      ];
    }

    // Church settings sit a tier below access control: these roles may edit the site's content,
    // but managing accounts, roles and invitations stays Super Admin only.
    //
    // The Content Editor is here because `settings/church` IS the public website — church
    // details, leaders, gallery, congregations, and the Home and About page copy. Nothing
    // privileged lives in it; roles and accounts are separate collections, gated below on
    // isSuperAdmin(), so this grant cannot be walked up into access control.
    function canEditSettings() {
      return roleId() in ['super-admin', 'admin', 'content-editor'];
    }

    // What the congregation publishes: teachings and events, which appear on the public site.
    //
    // Deliberately separate from canEditRecords(). That gate also covers attendance registers,
    // visitors and children's figures — personal data about named members that a website editor
    // has no business writing. Splitting the two is what stops "can update the events page" from
    // quietly meaning "can rewrite the attendance register".
    function canEditPublishedContent() {
      return roleId() in ['super-admin', 'admin', 'secretary', 'content-editor'];
    }

    // Money has its own tier: Super Admin, Admin and the Financial Secretary. Everyone else on
    // staff can read the books but not change them.
    function canEditFinance() {
      return roleId() in ['super-admin', 'admin', 'financial-secretary'];
    }

    // Records staff keep: teachings, attendance registers and events. Super Admin, Admin and
    // the Secretary. Deliberately narrower than the app's permission matrix — see the note in
    // README § Roles & permissions.
    function canEditRecords() {
      return roleId() in ['super-admin', 'admin', 'secretary'];
    }

    function invitationFor(email) {
      return get(/databases/$(database)/documents/invitations/$(email)).data;
    }

    function hasInvitation(email) {
      return exists(/databases/$(database)/documents/invitations/$(email));
    }

    match /users/{uid} {
      // An account reads its own record so the app can tell which role it holds.
      allow read: if signedIn() && request.auth.uid == uid;
      // Staff may read the roster to see who holds what.
      allow read: if isStaff();
      // Granting or changing a role is Super Admin only. Deliberately no general self-write:
      // otherwise any account could promote itself.
      allow write: if isSuperAdmin();

      // Claiming an invitation. Narrow on purpose:
      //   * create only — an account that already has a record cannot re-run this to change
      //     its own role, because the document already exists;
      //   * only its OWN uid;
      //   * only a verified email, so knowing an invited address is not enough;
      //   * only the exact role the invitation names, so the payload cannot ask for more;
      //   * only the member record the invitation names — otherwise a claimer could attach
      //     their login to anyone on the nominal roll. Omitting it entirely is fine.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.auth.token.email_verified == true
                    && hasInvitation(request.auth.token.email)
                    && request.resource.data.roleId == invitationFor(request.auth.token.email).roleId
                    && (!('memberId' in request.resource.data)
                        || request.resource.data.memberId
                           == invitationFor(request.auth.token.email).memberId);
    }

    // ── Invitations ────────────────────────────────────────────────────────
    // Keyed by lower-cased email so the id can be matched against the caller's token.
    match /invitations/{email} {
      // The invitee reads the invitation addressed to them in order to claim it.
      allow read: if signedIn() && request.auth.token.email == email;
      allow read: if isStaff();
      // Only a Super Admin may invite, or change what role an invitation carries.
      allow create, update: if isSuperAdmin();
      // Cleared by the Super Admin who sent it, or by the invitee once claimed.
      allow delete: if isSuperAdmin()
                    || (signedIn() && request.auth.token.email == email);
    }

    // ── Audit log ──────────────────────────────────────────────────────────
    // Append-only by design: no rule grants update or delete, so an entry cannot be edited
    // or quietly removed — not even by a Super Admin. Any staff account may add an entry,
    // because every staff action needs to record itself, but only as itself: `actorUid` must
    // be the caller. Reading the log is Super Admin only.
    //
    // This is written by the client, so it evidences what the app did, not everything that
    // happened: nothing can force a client to write an entry. A trail that cannot be bypassed
    // needs a Firestore trigger in Cloud Functions.
    match /auditLog/{entryId} {
      allow read: if isSuperAdmin();
      allow create: if isStaff()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.action is string
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── Role definitions ───────────────────────────────────────────────────
    // Permission-matrix overrides only, keyed by role id. Names, colours and ids stay in
    // code, so there is nothing here that can invent a role or rename an existing one.
    match /roles/{roleId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // ── Role assignments ───────────────────────────────────────────────────
    // Who holds which role in the congregation. Presentational: this grants no access,
    // it records that a member is an elder or a deacon. Writing it is still privileged,
    // since it drives what the dashboard shows about people.
    match /roleAssignments/{assignmentId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // ── Finances ───────────────────────────────────────────────────────────
    // Money in and money out, kept apart because they are reported on separately. Never public:
    // these are the congregation's books.
    match /financeCollections/{entryId} {
      allow read: if isStaff();
      allow write: if canEditFinance();
    }

    match /financeExpenses/{entryId} {
      allow read: if isStaff();
      allow write: if canEditFinance();
    }

    // ── Teachings ──────────────────────────────────────────────────────────
    // Sermons and Sunday School lessons. Staff-read for now: the public teachings pages still
    // read their own store, so nothing outside the dashboard needs this yet.
    match /teachings/{sermonId} {
      allow read: if isStaff();
      allow write: if canEditPublishedContent();
    }

    // ── Attendance ─────────────────────────────────────────────────────────
    // Who was present at which service. Personal data about named members, so never public.
    match /attendance/{recordId} {
      allow read: if isStaff();
      allow write: if canEditRecords();
    }

    // ── Visitors & children ────────────────────────────────────────────────
    // Who was at a service without being on the roll. Visitors hand over a name, phone number,
    // address and email on a slip of paper, so this is personal data about people who are not
    // even members — never public, staff read only.
    match /visitors/{visitorId} {
      // Pinned so the collection cannot become a dumping ground. Only the name is required: the
      // rest is whatever the visitor was willing to write down, and a declined phone number must
      // not stop the visit being recorded.
      function visitorShapeIsValid(data) {
        return data.keys().hasOnly([
                 'name', 'address', 'phone', 'email', 'church',
                 'date', 'serviceType', 'createdAt'
               ])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 120
          && data.date is string && data.date.size() <= 10
          && data.serviceType is string && data.serviceType.size() <= 60
          && (!('address' in data) || (data.address is string && data.address.size() <= 300))
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
          && (!('email' in data) || (data.email is string && data.email.size() <= 200))
          && (!('church' in data) || (data.church is string && data.church.size() <= 200));
      }

      allow read: if isStaff();
      allow create, update: if canEditRecords() && visitorShapeIsValid(request.resource.data);
      allow delete: if canEditRecords();
    }

    // How many children were at a service. A count, not a register — the children's class is not
    // on the nominal roll. Negative or absurd figures are refused rather than stored and puzzled
    // over later.
    match /childrenAttendance/{serviceKey} {
      allow read: if isStaff();
      allow write: if canEditRecords()
                   && request.resource.data.count is int
                   && request.resource.data.count >= 0
                   && request.resource.data.count <= 10000
                   && request.resource.data.date is string
                   && request.resource.data.serviceType is string;
    }

    // ── Events ─────────────────────────────────────────────────────────────
    // Publicly readable: the /events page lists these to visitors while signed out.
    match /events/{eventId} {
      allow read: if true;
      allow write: if canEditPublishedContent();
    }

    // ── Contact messages ───────────────────────────────────────────────────
    // The public "Send Us A Message" form writes here while signed out, which makes this the
    // one collection anonymous callers can add to. Create-only for them, and nothing else:
    // a visitor cannot list, read, edit or delete a message, including their own.
    //
    // The shape is pinned so the endpoint cannot be used as free storage, and `read`/`handled`
    // are forced false so a submission cannot arrive already dismissed from the inbox.
    // `submittedAt` must be the server's time, not a client's claim about it.
    //
    // What this does NOT do is rate-limit — rules cannot. A flood is still possible; the fix
    // is App Check or a Cloud Function, see README § Contact messages.
    match /messages/{messageId} {
      function messageIsValid(data) {
        return data.keys().hasOnly(['name', 'email', 'phone', 'message', 'submittedAt', 'read', 'handled'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 120
          && data.email is string && data.email.size() > 0 && data.email.size() <= 200
          && data.phone is string && data.phone.size() <= 40
          && data.message is string && data.message.size() > 0 && data.message.size() <= 4000
          && data.read == false
          && data.handled == false
          && data.submittedAt == request.time;
      }

      allow read: if isStaff();
      allow create: if messageIsValid(request.resource.data);
      // Staff triage: only the two flags may change, so an edit cannot rewrite what was sent.
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['read', 'handled']);
      allow delete: if isStaff();
    }

    // ── Bible Lectureship registrations ────────────────────────────────────
    // The public Lectureship registration form writes here while signed out — the same
    // anonymous-create shape as `messages`, above. Create-only for them: a visitor cannot
    // list, read, edit or delete a registration, including their own.
    match /lectureshipRegistrations/{registrationId} {
      function registrationIsValid(data) {
        return data.keys().hasOnly(['fullName', 'email', 'congregation', 'phone', 'submittedAt'])
          && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120
          && data.email is string && data.email.size() > 0 && data.email.size() <= 200
          && data.congregation is string && data.congregation.size() > 0 && data.congregation.size() <= 200
          && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40
          && data.submittedAt == request.time;
      }

      allow read: if isStaff();
      allow create: if registrationIsValid(request.resource.data);
      // Staff check-in on the day: only the two attendance flags may change, so an edit
      // cannot rewrite what the registrant originally submitted.
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['attendedSat', 'attendedSun'])
                    && request.resource.data.attendedSat is bool
                    && request.resource.data.attendedSun is bool;
      allow delete: if isStaff();
    }

    // ── Church settings ────────────────────────────────────────────────────
    match /settings/{document} {
      allow read: if true;
      // Super Admin and Admin. Elders and secretaries hold view-only Settings in the app's
      // matrix, so they get no write here.
      allow write: if canEditSettings();
    }

    // ── Members ────────────────────────────────────────────────────────────
    match /members/{memberId} {

      // Fields the app writes. Anything else is rejected, so the open create
      // endpoint can't be used to store arbitrary data.
      function allowedFields() {
        return [
          'name', 'gender', 'phone', 'email', 'dob', 'status', 'absenceCount',
          'avatar', 'churchNumber', 'maritalStatus', 'dateOfBaptism',
          'dateJoined', 'country', 'state', 'localGovernment', 'village',
          'address', 'occupation', 'previousCongregation',
          'previousMinisterPhone', 'emergencyContact', 'createdAt', 'updatedAt',
          // Youth schooling details — see the `Member` type.
          'school', 'department', 'courseOfStudy', 'program', 'level',
          'hallOfResidence', 'yearOfEntry', 'yearOfExit', 'comment'
        ];
      }

      function shapeIsValid(data) {
        return data.keys().hasOnly(allowedFields())
          && data.name is string && data.name.size() > 0 && data.name.size() <= 120
          && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40
          && data.gender in ['Male', 'Female']
          && (!('email' in data) || (data.email is string && data.email.size() <= 200))
          && (!('address' in data) || (data.address is string && data.address.size() <= 300))
          // `comment` is the only free-form text box on the record, so it is the one worth
          // capping — an uncapped note is a document-size limit waiting to be hit.
          && (!('comment' in data) || (data.comment is string && data.comment.size() <= 2000));
      }

      // A self-registration may not hand itself a privileged status or a
      // pre-cooked absence count — the secretary sets those later.
      function selfRegistrationIsSane(data) {
        return data.status == 'Active' && data.absenceCount == 0;
      }

      allow read: if isStaff();
      // Staff may create any valid record; the public form may create only a plain,
      // unprivileged one. isStaff() is false (not an error) for anonymous callers.
      allow create: if shapeIsValid(request.resource.data)
                    && (isStaff() || selfRegistrationIsSane(request.resource.data));
      allow update, delete: if isStaff();
    }

    // ── Church number reservations ─────────────────────────────────────────
    // One document per assigned church (membership) number, keyed by a normalised form of it,
    // holding the member it belongs to. Firestore has no unique constraint, so this collection
    // IS the constraint: the app claims a number in a transaction, and a second claim on the
    // same key fails.
    //
    // Only staff touch these, and never directly — `membersRepository` writes them alongside
    // the member record. The update rule refuses to repoint an existing reservation at a
    // different member, so a number cannot be taken off whoever holds it by a stray write;
    // reassigning it means releasing it first, which is what the transaction does.
    match /memberNumbers/{numberKey} {
      allow read: if isStaff();
      allow create, delete: if isStaff();
      allow update: if isStaff()
                    && request.resource.data.memberId == resource.data.memberId;
    }

    // Anything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
