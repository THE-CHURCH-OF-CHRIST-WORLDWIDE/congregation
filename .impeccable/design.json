      "html": "<div class=\"ds-row\"><span class=\"ds-badge ds-success\">Active</span><span class=\"ds-badge ds-danger\">Expense</span><span class=\"ds-badge ds-neutral\">12 perms</span><span class=\"ds-badge ds-role\">Super Admin</span><span class=\"ds-stamp\">Sermon</span></div>",
      "css": ":host{--c-surface:#fff;--c-surface-muted:#f5f7fa;--c-surface-sunken:#ebeff5;--c-rule:#d5deea;--c-rule-strong:#b4c3d6;--c-margin:#c0392b;--c-ink:#172131;--c-ink-muted:#4b5768;--c-ink-subtle:#5f6b7c;--c-primary:#1e4d3b;--c-primary-hover:#163b2d;--c-primary-active:#10301f;--c-primary-soft:#e6efea;--c-on-primary:#fff;--c-secondary:#24364f;--c-accent:#8a5d0f;--c-accent-soft:#f6eedd;--c-success:#1f7a45;--c-success-soft:#e5f3ea;--c-error:#b42318;--c-error-soft:#fdecea;--c-focus:#1f5fa8;}.ds-row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-family:'Public Sans',ui-sans-serif,system-ui,sans-serif;}.ds-badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:600;box-shadow:inset 0 0 0 1px var(--r);}.ds-success{background:var(--c-success-soft);color:var(--c-success);--r:rgb(31 122 69 / 0.25);}.ds-danger{background:var(--c-error-soft);color:var(--c-error);--r:rgb(180 35 24 / 0.25);}.ds-neutral{background:var(--c-surface-sunken);color:var(--c-ink-muted);--r:rgb(180 195 214 / 0.6);}.ds-role{background:var(--c-primary-soft);color:var(--c-primary);--r:rgb(30 77 59 / 0.2);}.ds-stamp{display:inline-block;padding:4px 8px;border-radius:4px;background:var(--c-accent-soft);color:var(--c-accent);font-size:12px;line-height:16px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;box-shadow:inset 0 0 0 1px rgb(138 93 15 / 0.2);}"
