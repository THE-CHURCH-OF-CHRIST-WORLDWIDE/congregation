      "html": "<button class=\"ds-btn-secondary\">Export</button>",
      "css": ":host{--c-surface:#fff;--c-surface-muted:#f5f7fa;--c-surface-sunken:#ebeff5;--c-rule:#d5deea;--c-rule-strong:#b4c3d6;--c-margin:#c0392b;--c-ink:#172131;--c-ink-muted:#4b5768;--c-ink-subtle:#5f6b7c;--c-primary:#1e4d3b;--c-primary-hover:#163b2d;--c-primary-active:#10301f;--c-primary-soft:#e6efea;--c-on-primary:#fff;--c-secondary:#24364f;--c-accent:#8a5d0f;--c-accent-soft:#f6eedd;--c-success:#1f7a45;--c-success-soft:#e5f3ea;--c-error:#b42318;--c-error-soft:#fdecea;--c-focus:#1f5fa8;}.ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 16px;border-radius:6px;font-size:14px;font-weight:600;white-space:nowrap;cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms;font-family:'Public Sans',ui-sans-serif,system-ui,sans-serif;background:var(--c-surface);color:var(--c-ink);border:1px solid var(--c-rule-strong);box-shadow:0 1px 2px rgb(23 33 49 / 0.06);}.ds-btn-secondary:hover{background:var(--c-surface-muted);border-color:var(--c-ink-subtle);}.ds-btn-secondary:active{background:var(--c-surface-sunken);}.ds-btn-secondary:focus-visible{outline:2px solid var(--c-focus);outline-offset:2px;}"
