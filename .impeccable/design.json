      "html": "<div class=\"ds-margin\"><h1 class=\"ds-title\">Attendance</h1><p class=\"ds-sub\">Sunday morning worship, November</p></div>",
      "css": ":host{--c-surface:#fff;--c-surface-muted:#f5f7fa;--c-surface-sunken:#ebeff5;--c-rule:#d5deea;--c-rule-strong:#b4c3d6;--c-margin:#c0392b;--c-ink:#172131;--c-ink-muted:#4b5768;--c-ink-subtle:#5f6b7c;--c-primary:#1e4d3b;--c-primary-hover:#163b2d;--c-primary-active:#10301f;--c-primary-soft:#e6efea;--c-on-primary:#fff;--c-secondary:#24364f;--c-accent:#8a5d0f;--c-accent-soft:#f6eedd;--c-success:#1f7a45;--c-success-soft:#e5f3ea;--c-error:#b42318;--c-error-soft:#fdecea;--c-focus:#1f5fa8;}.ds-margin{position:relative;padding-left:20px;font-family:'Public Sans',ui-sans-serif,system-ui,sans-serif;}.ds-margin::before{content:\"\";position:absolute;top:0;bottom:0;left:0;width:5px;border-left:1px solid var(--c-margin);border-right:1px solid var(--c-margin);opacity:0.85;}.ds-title{margin:0;font-family:Bitter,'Roboto Slab',Rockwell,Georgia,serif;font-size:26px;line-height:1.25;font-weight:700;letter-spacing:-0.01em;color:var(--c-ink);}.ds-sub{margin:2px 0 0;font-size:14px;color:var(--c-ink-muted);}"
