      "html": "<ol class=\"ds-rows\"><li><a href=\"#\" class=\"ds-row\"><span class=\"ds-day\">14</span><span><span class=\"ds-stamp\">Dec · Sunday</span><span class=\"ds-title\">Carol service</span><span class=\"ds-meta\">6:00 pm · Main auditorium</span></span></a></li><li><a href=\"#\" class=\"ds-row\"><span class=\"ds-day\">21</span><span><span class=\"ds-stamp\">Dec · Sunday</span><span class=\"ds-title\">Year-end thanksgiving</span><span class=\"ds-meta\">9:00 am</span></span></a></li></ol>",
      "css": ".ds-rows{list-style:none;margin:0;padding:0;border-top:1px solid rgb(27 26 23 / .8);background:#f3efe6;font-family:'Manrope',sans-serif}.ds-rows li{border-bottom:1px solid #c8bfad}.ds-row{display:grid;grid-template-columns:5.5rem 1fr;gap:1.25rem;align-items:center;padding:1.75rem 0;color:#1b1a17;text-decoration:none}.ds-day{font-family:'Instrument Serif',Georgia,serif;font-size:3.5rem;line-height:.85;font-variant-numeric:tabular-nums lining-nums}.ds-stamp{display:block;font-size:.6875rem;line-height:1rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#8a6a3b}.ds-title{display:block;margin-top:.25rem;font-family:'Instrument Serif',Georgia,serif;font-size:1.75rem;line-height:1.1;transition:color .5s cubic-bezier(.16,1,.3,1),transform .5s cubic-bezier(.16,1,.3,1)}.ds-row:hover .ds-title{color:#2f3d2c;transform:translateX(6px)}.ds-meta{display:block;margin-top:.5rem;font-size:.875rem;color:#4f4b43;font-variant-numeric:tabular-nums}.ds-row:focus-visible{outline:2px solid #2f3d2c;outline-offset:3px}"
