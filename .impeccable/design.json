  "components": [
    {
      "name": "Public Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Forest call to action on ivory; a darker fill wipes up from the baseline on hover.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Plan a visit <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:.625rem;min-height:3rem;padding:0 1.5rem;border-radius:2px;border:0;font-family:'Manrope',sans-serif;font-size:.9375rem;font-weight:600;letter-spacing:.01em;white-space:nowrap;isolation:isolate;overflow:hidden;cursor:pointer;transition:color 220ms cubic-bezier(.25,1,.5,1),border-color 220ms cubic-bezier(.25,1,.5,1)}.ds-btn::before{content:'';position:absolute;inset:0;z-index:-1;transform:scaleY(0);transform-origin:bottom;transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-btn:hover::before{transform:scaleY(1)}.ds-btn svg{transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-btn:hover svg{transform:translateX(4px)}.ds-btn:focus-visible{outline:2px solid var(--c-focus,#2f3d2c);outline-offset:3px}.ds-btn-primary{background:var(--c-primary,#2f3d2c);color:var(--c-on-primary,#faf8f3)}.ds-btn-primary::before{background:var(--c-primary-active,#1d271b)}"
    },
    {
      "name": "Public Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Strong hairline secondary action; wipes to solid ink on hover.",
      "html": "<button class=\"ds-btn ds-btn-outline\">All teachings</button>",
      "css": ".ds-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:.625rem;min-height:3rem;padding:0 1.5rem;border-radius:2px;border:0;font-family:'Manrope',sans-serif;font-size:.9375rem;font-weight:600;letter-spacing:.01em;white-space:nowrap;isolation:isolate;overflow:hidden;cursor:pointer;transition:color 220ms cubic-bezier(.25,1,.5,1),border-color 220ms cubic-bezier(.25,1,.5,1)}.ds-btn::before{content:'';position:absolute;inset:0;z-index:-1;transform:scaleY(0);transform-origin:bottom;transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-btn:hover::before{transform:scaleY(1)}.ds-btn svg{transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-btn:hover svg{transform:translateX(4px)}.ds-btn:focus-visible{outline:2px solid var(--c-focus,#2f3d2c);outline-offset:3px}.ds-btn-outline{background:transparent;color:var(--c-ink,#1b1a17);border:1px solid var(--c-rule-strong,#c8bfad)}.ds-btn-outline::before{background:var(--c-ink,#1b1a17)}.ds-btn-outline:hover{color:var(--c-surface,#faf8f3);border-color:var(--c-ink,#1b1a17)}"
    },
    {
      "name": "Light Button (on night)",
      "kind": "button",
      "refersTo": "button-light",
      "description": "Ivory button on night or forest fields; champagne wipes up on hover.",
      "html": "<div style=\"background:#1a1916;padding:24px\"><button class=\"ds-btn ds-btn-light\">Watch live</button></div>",
      "css": ".ds-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:.625rem;min-height:3rem;padding:0 1.5rem;border-radius:2px;border:0;font-family:'Manrope',sans-serif;font-size:.9375rem;font-weight:600;letter-spacing:.01em;white-space:nowrap;isolation:isolate;overflow:hidden;cursor:pointer;transition:color 220ms cubic-bezier(.25,1,.5,1),border-color 220ms cubic-bezier(.25,1,.5,1)}.ds-btn::before{content:'';position:absolute;inset:0;z-index:-1;transform:scaleY(0);transform-origin:bottom;transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-btn:hover::before{transform:scaleY(1)}.ds-btn svg{transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-btn:hover svg{transform:translateX(4px)}.ds-btn:focus-visible{outline:2px solid var(--c-focus,#2f3d2c);outline-offset:3px}.ds-btn-light{background:var(--c-on-night,#f3efe6);color:var(--c-night,#1a1916)}.ds-btn-light::before{background:var(--c-champagne,#d4bc8e)}.ds-btn-light:focus-visible{outline-color:#d4bc8e}"
    },
    {
      "name": "Admin Button",
      "kind": "button",
      "refersTo": "button-admin-primary",
      "description": "Standard operational button: forest primary and ivory secondary, colour transitions only.",
      "html": "<div style=\"display:flex;gap:8px\"><button class=\"ds-abtn ds-abtn-primary\">Save changes</button><button class=\"ds-abtn ds-abtn-secondary\">Export CSV</button></div>",
      "css": ".ds-abtn{display:inline-flex;align-items:center;gap:.5rem;min-height:2.5rem;padding:0 1rem;border-radius:2px;font-family:'Manrope',sans-serif;font-size:.875rem;font-weight:600;letter-spacing:.01em;cursor:pointer;border:1px solid transparent;transition:background-color 150ms,border-color 150ms}.ds-abtn:focus-visible{outline:2px solid #2f3d2c;outline-offset:2px}.ds-abtn-primary{background:var(--c-primary,#2f3d2c);color:var(--c-on-primary,#faf8f3)}.ds-abtn-primary:hover{background:var(--c-primary-hover,#263223)}.ds-abtn-primary:active{background:var(--c-primary-active,#1d271b)}.ds-abtn-secondary{background:var(--c-surface,#faf8f3);color:var(--c-ink,#1b1a17);border-color:var(--c-rule-strong,#c8bfad)}.ds-abtn-secondary:hover{background:var(--c-surface-muted,#f3efe6);border-color:var(--c-ink-subtle,#6b665c)}"
    },
    {
      "name": "Editorial Link",
      "kind": "custom",
      "refersTo": "link-line",
      "description": "Inline link whose 1px underline retracts on hover while the arrow nudges forward.",
      "html": "<a href=\"#\" class=\"ds-link\"><span class=\"ds-link-text\">Read the letter</span><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a>",
      "css": ".ds-link{display:inline-flex;align-items:center;gap:.5rem;min-height:2.75rem;font-family:'Manrope',sans-serif;font-weight:600;color:#1b1a17;text-decoration:none}.ds-link-text{background-image:linear-gradient(currentColor,currentColor);background-size:100% 1px;background-position:0 100%;background-repeat:no-repeat;padding-bottom:2px;transition:background-size .5s cubic-bezier(.16,1,.3,1)}.ds-link:hover .ds-link-text{background-size:0% 1px;background-position:100% 100%}.ds-link svg{transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-link:hover svg{transform:translateX(4px)}.ds-link:focus-visible{outline:2px solid #2f3d2c;outline-offset:3px}"
    },
    {
      "name": "Public Field",
      "kind": "input",
      "refersTo": "field-input-public",
      "description": "Boxless underlined field with a tracked label; the line turns forest and doubles on focus.",
      "html": "<label class=\"ds-flabel\" for=\"ds-f\">Your name</label><input id=\"ds-f\" class=\"ds-field\" placeholder=\"Full name\">",
      "css": ".ds-flabel{display:block;font-family:'Manrope',sans-serif;font-size:.6875rem;line-height:1rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#4f4b43}.ds-field{width:100%;min-height:3rem;border:0;border-bottom:1px solid #c8bfad;border-radius:0;background:transparent;padding:.75rem 0;font-family:'Manrope',sans-serif;font-size:1.0625rem;color:#1b1a17;outline:none;caret-color:#8a6a3b;transition:border-color 220ms,box-shadow 220ms}.ds-field::placeholder{color:#6b665c}.ds-field:hover{border-bottom-color:#6b665c}.ds-field:focus{border-bottom-color:#2f3d2c;box-shadow:0 1px 0 0 #2f3d2c}"
