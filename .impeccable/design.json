      "css": ":host{--c-surface:#fff;--c-surface-muted:#f5f7fa;--c-surface-sunken:#ebeff5;--c-rule:#d5deea;--c-rule-strong:#b4c3d6;--c-margin:#c0392b;--c-ink:#172131;--c-ink-muted:#4b5768;--c-ink-subtle:#5f6b7c;--c-primary:#1e4d3b;--c-primary-hover:#163b2d;--c-primary-active:#10301f;--c-primary-soft:#e6efea;--c-on-primary:#fff;--c-secondary:#24364f;--c-accent:#8a5d0f;--c-accent-soft:#f6eedd;--c-success:#1f7a45;--c-success-soft:#e5f3ea;--c-error:#b42318;--c-error-soft:#fdecea;--c-focus:#1f5fa8;}.ds-card{background:var(--c-surface);border:1px solid var(--c-rule);border-radius:8px;padding:20px;box-shadow:0 1px 2px rgb(23 33 49 / 0.06);transition:border-color 150ms,box-shadow 150ms;font-family:'Public Sans',ui-sans-serif,system-ui,sans-serif;}.ds-card:hover{border-color:var(--c-rule-strong);box-shadow:0 2px 4px rgb(23 33 49 / 0.05),0 6px 16px rgb(23 33 49 / 0.08);}.ds-stat-label{margin:0;font-size:12px;font-weight:600;letter-spacing:0.025em;text-transform:uppercase;color:var(--c-ink-muted);}.ds-stat-value{margin:8px 0 0;font-family:Bitter,'Roboto Slab',Rockwell,Georgia,serif;font-size:30px;line-height:1;font-weight:600;color:var(--c-ink);font-variant-numeric:tabular-nums lining-nums;}.ds-stat-meta{margin:12px 0 0;font-size:12px;color:var(--c-ink-subtle);font-variant-numeric:tabular-nums;}"
