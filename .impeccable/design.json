      "css": ":host{--c-surface:#fff;--c-surface-muted:#f5f7fa;--c-surface-sunken:#ebeff5;--c-rule:#d5deea;--c-rule-strong:#b4c3d6;--c-margin:#c0392b;--c-ink:#172131;--c-ink-muted:#4b5768;--c-ink-subtle:#5f6b7c;--c-primary:#1e4d3b;--c-primary-hover:#163b2d;--c-primary-active:#10301f;--c-primary-soft:#e6efea;--c-on-primary:#fff;--c-secondary:#24364f;--c-accent:#8a5d0f;--c-accent-soft:#f6eedd;--c-success:#1f7a45;--c-success-soft:#e5f3ea;--c-error:#b42318;--c-error-soft:#fdecea;--c-focus:#1f5fa8;}.ds-field{display:flex;flex-direction:column;gap:6px;font-family:'Public Sans',ui-sans-serif,system-ui,sans-serif;}.ds-field-label{font-size:14px;font-weight:500;color:var(--c-ink);}.ds-req{color:var(--c-error);margin-left:2px;}.ds-field-help{font-size:12px;color:var(--c-ink-subtle);}.ds-input{min-height:40px;padding:8px 12px;border:1px solid var(--c-rule-strong);border-radius:6px;background:var(--c-surface);color:var(--c-ink);font-size:14px;outline:none;caret-color:var(--c-primary);box-shadow:0 1px 2px rgb(23 33 49 / 0.06);transition:border-color 150ms,box-shadow 150ms;}.ds-input::placeholder{color:var(--c-ink-subtle);}.ds-input:hover{border-color:var(--c-ink-subtle);}.ds-input:focus{border-color:var(--c-primary);box-shadow:0 0 0 3px rgb(30 77 59 / 0.15);}"
