      "css": ".ds-alabel{display:block;margin-bottom:6px;font-family:'Manrope',sans-serif;font-size:.875rem;font-weight:500;color:#1b1a17}.ds-ainput{width:100%;min-height:2.5rem;padding:.5rem .75rem;border:1px solid #c8bfad;border-radius:2px;background:#faf8f3;color:#1b1a17;font-family:'Manrope',sans-serif;font-size:.875rem;outline:none;transition:border-color 150ms,box-shadow 150ms}.ds-ainput:hover{border-color:#6b665c}.ds-ainput:focus{border-color:#2f3d2c;box-shadow:0 0 0 3px rgb(47 61 44 / .15)}"
