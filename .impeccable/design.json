      "css": ".ds-nav{display:flex;gap:1.75rem;align-items:center;padding:0 1.5rem;height:5rem;background:rgb(250 248 243 / .92);border-bottom:1px solid #e2dccf;font-family:'Manrope',sans-serif}.ds-nav-link{position:relative;display:inline-flex;align-items:center;min-height:2.75rem;font-size:.875rem;font-weight:500;letter-spacing:.01em;color:#1b1a17;text-decoration:none;opacity:.78;transition:opacity .3s cubic-bezier(.25,1,.5,1)}.ds-nav-link::after{content:'';position:absolute;left:0;right:0;bottom:.45rem;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .55s cubic-bezier(.16,1,.3,1)}.ds-nav-link:hover,.ds-nav-link.is-active{opacity:1}.ds-nav-link:hover::after{transform:scaleX(1);transform-origin:left}.ds-nav-link.is-active::after{transform:scaleX(1);background:#8a6a3b}.ds-nav-link:focus-visible{outline:2px solid #2f3d2c;outline-offset:3px}"
