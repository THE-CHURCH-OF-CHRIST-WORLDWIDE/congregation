# Copy to `.env` for day-to-day local work.
#
# Each environment is a SEPARATE Firebase project, so each gets its own env file:
#   .env              → whichever project you develop against (usually staging)
#   .env.staging      → congregation-staging   (npm run dev:staging / build:staging)
#   .env.production   → congregation-prod      (npm run build:production)
# All three are git-ignored. See docs/firebase-setup.md § Environments.

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Get these values from your Firebase project console:
# https://console.firebase.google.com → Project Settings → Your apps → SDK setup
# Make sure you are in the right project — staging and prod configs look alike.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Used as the image host for all uploads. Files go to Cloudinary first, then
# the returned secure URL is what we store in Firestore.
#   - Cloud name: dashboard → Account Details
#   - Upload preset: Settings → Upload → Add upload preset (signing mode: Unsigned)
# Optionally set a folder name to keep all church uploads grouped.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_FOLDER=congregation

# ─── App ──────────────────────────────────────────────────────────────────────
# One of: development | staging | production
# Anything other than `production` shows the environment banner in the admin
# dashboard, so a staging build never looks like the live site.
APP_ENV=development
