# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist
CLAUDE.md

# Stray tsc/vue-tsc output emitted next to sources. These directories are
# TypeScript-only, so any .js sibling here is a build artifact, never source.
*.vue.js
*.vue.d.ts
/composables/**/*.js
/plugins/**/*.js
/stores/**/*.js
/utils/**/*.js


# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
# `.env` needs its own line — `.env.*` does not match it, which is how a real
# production .env once got committed.
.env
.env.*
!.env.example
!.env.test

# Local Netlify folder
.netlify
